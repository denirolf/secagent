# ---- Anthropic / Claude ----
# Required for standalone deployment. In the Claude Code cloud session the SDK
# uses ambient CLI auth and this can be left blank.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://secagent:secagent@localhost:5432/secagent
DATABASE_URL_SYNC=postgresql+psycopg2://secagent:secagent@localhost:5432/secagent

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Run limits (defaults; per-project values override) ----
DEFAULT_MAX_ITERATIONS=12
DEFAULT_MAX_TOOL_CALLS=40
DEFAULT_MAX_BUDGET_USD=5.0

# ---- Sandbox ----
# Docker network that lab targets live on. The sandbox restricts tool
# containers to this network only.
SANDBOX_NETWORK=secagent_lab
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=300

# ======================= Phase 5: production hardening =======================

# ---- Auth + RBAC ----
# Off by default so local dev, the test suite, and the e2e run without credentials.
# Turn on for any shared/production deployment and set a strong, unique pepper.
AUTH_ENABLED=false
API_KEY_PEPPER=
# If set to an 'sk-...' token (and a pepper) and no keys exist yet, an admin key is
# adopted on startup. Otherwise create the first key with scripts/create_api_key.py.
BOOTSTRAP_ADMIN_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# ---- Rate limiting (token bucket per API key / client IP). Per-minute 0 disables. ----
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40

# ---- Observability ----
METRICS_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false

# ---- CORS (browser origins allowed to call the API; the dashboard) ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Cost control (estimates; 0.0 = off). Set to your model's measured per-unit cost
#      so a project's DEFAULT_MAX_BUDGET_USD ceiling can stop a run before a real bill. ----
EST_COST_PER_ITERATION_USD=0.0
EST_COST_PER_TOOL_CALL_USD=0.0

# ---- Secrets ----
# Secrets may be mounted as files (Docker/K8s) named by alias, e.g.
# /run/secrets/API_KEY_PEPPER. Default dir is /run/secrets when present; override here.
# SECRETS_DIR=/run/secrets
